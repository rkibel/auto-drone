      <joint name="left_proxy_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_proxy_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <joint name="right_proxy_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_proxy_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_proxy_wheel_joint</left_joint>
        <right_joint>right_proxy_wheel_joint</right_joint>
        <wheel_separation>0.48</wheel_separation>
        <wheel_radius>0.10</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <odom_publish_frequency>25</odom_publish_frequency>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>
