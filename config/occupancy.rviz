Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Tree occupancy
      Namespaces:
        tree_occupancy: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /auto_drone_px4_control/occupied_voxels
    - Alpha: 1
      Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Drone
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /auto_drone_px4_control/drone
    - Alpha: 1
      Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Camera frustum
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /auto_drone_px4_control/camera_frustum
  Global Options:
    Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Focal Point:
        X: 0
        Y: 10
        Z: 5
      Pitch: 0.7
      Target Frame: map
      Value: Orbit (rviz)
      Yaw: 0.8
Window Geometry:
  Height: 800
  Width: 1200
